# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase publishable (anon) key. Used only on the server; all data access goes
# through SECURITY DEFINER functions that check the session and role.
SUPABASE_ANON_KEY=sb_publishable_xxx
# Public site address used for canonical and Open Graph links
